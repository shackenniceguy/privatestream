# ==============================================================================
# PrivateStream ("Private Netflix") Configuration Environment
# ==============================================================================

# --- TMDB (The Movie Database) Configuration ---
# Get your free v3 API key from: https://www.themoviedb.org/settings/api
TMDB_API_KEY=your_tmdb_api_key_here
TMDB_LANGUAGE=ru-RU

# --- Telegram Bot Configuration (aiogram 3.x) ---
# Create a bot via @BotFather on Telegram and paste the token here:
TELEGRAM_BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrsTUVwxyz
# Comma-separated list of allowed Telegram user IDs (e.g. 123456789,987654321):
ALLOWED_USER_ID=123456789

# --- Google Drive & Rclone Mount Settings ---
# Remote name configured in rclone.conf (e.g., 'gdrive')
RCLONE_REMOTE_NAME=gdrive
RCLONE_MOUNT_PATH=/mnt/gdrive
# Optional custom Google Cloud OAuth credentials to prevent API rate limits:
RCLONE_DRIVE_CLIENT_ID=
RCLONE_DRIVE_CLIENT_SECRET=

# --- qBittorrent-nox WebUI Credentials ---
QBITTORRENT_HOST=qbittorrent-nox
QBITTORRENT_PORT=8080
QBITTORRENT_USER=admin
QBITTORRENT_PASSWORD=adminadmin

# --- Paths and Directories ---
LOCAL_DOWNLOAD_DIR=/data/local_downloads
VFS_CACHE_DIR=/data/vfs_cache
REMOTE_MEDIA_DIR=/mnt/gdrive/Media

# --- Database & Security ---
DATABASE_URL=sqlite+aiosqlite:////data/db/privatestream.db
API_SECRET_KEY=generate_a_random_32_byte_hex_string_here_for_production
API_HOST=0.0.0.0
API_PORT=8000

